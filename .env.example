# 复制为 .env 并按本机情况填写：Copy-Item .env.example .env
# .env 已被 .gitignore 忽略，绝不入库；本文件只作模板（阶段 8 会补充完整变量清单）
# 所有值都是占位符，请勿把真实口令提交到版本库。

# 必填：SQLAlchemy 连接串（postgresql+psycopg://用户:口令@主机:5432/库名）
BANK_AGENT_DB_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/bank_agent_legacy

# 可选：测试库连接串（仅需要时取消注释）
#BANK_AGENT_TEST_DB_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/bank_agent_test

# Windows 下保持 UTF-8 输出
PYTHONIOENCODING=utf-8
