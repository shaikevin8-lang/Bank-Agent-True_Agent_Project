# ============================================================================
# Bank-Agent 演示环境变量模板（阶段 8 / D12）
# ----------------------------------------------------------------------------
# 用法：复制为 .env 后填写，.env 已被 .gitignore 忽略（.gitignore:42-46），绝不入库。
#       Windows：Copy-Item .env.example .env      Linux/macOS：cp .env.example .env
# 约定：等号两侧不加空格，值不加引号；空值表示「不配置，走代码内缺省」。
# 本文件只作模板，不得写入任何真实密钥/口令；真实值只落在本机 .env。
# 变量名以 Struct_of_Agent/ 代码实际读取的名字为准（逐项已核对，见各节注释）。
# ============================================================================


# ----------------------------------------------------------------------------
# 1. 数据库与容器端口
# ----------------------------------------------------------------------------

# 必填：SQLAlchemy 连接串（postgresql+psycopg://用户:口令@主机:端口/库名）。
#   宿主侧直跑服务：主机写 127.0.0.1；容器内跑服务：主机必须写 db（容器里的
#   127.0.0.1 是它自己，不是宿主）。读取点：Struct_of_Agent/db/session.py:32，
#   缺失时启动 fail-fast（start_server.vbs 打印诊断后 exit 1）。
BANK_AGENT_DB_URL=postgresql+psycopg://bank:CHANGE_ME@127.0.0.1:5432/bank_agent_legacy

# 可选：集成测试用的维护库连接串（Struct_of_Agent/Example/_pg.py:22）。
#   不填时依赖 PostgreSQL 的用例自动跳过（不算失败）。一般保持注释。
#BANK_AGENT_TEST_DB_URL=postgresql+psycopg://bank:CHANGE_ME@127.0.0.1:5432/bank_agent_test

# 宿主端口映射（只被 docker-compose.yml 插值，Python 代码不读取这些变量）。
# 宿主端口冲突时改这里即可，容器内端口不变：例如 PG 被本机 bank-agent-pg 占用时
# 设 BANK_AGENT_PG_PORT=15432，访问改为 127.0.0.1:15432。
BANK_AGENT_PG_PORT=5432
BANK_AGENT_API_PORT=8000
BANK_AGENT_MODEL_MOCK_PORT=8010

# 容器内连接串覆盖（同样只被 compose 插值，代码不读）：compose 里 migrate/app 的
# BANK_AGENT_DB_URL 取值是 ${BANK_AGENT_DOCKER_DB_URL:-postgresql+psycopg://bank@db:5432/bank_agent_legacy}。
# 一般保持注释；需要换容器内库地址或加口令时才取消注释。
#BANK_AGENT_DOCKER_DB_URL=postgresql+psycopg://bank@db:5432/bank_agent_legacy


# ----------------------------------------------------------------------------
# 2. 模型与搜索（可选；不填即离线 Mock / 规则路由，六场景照样可跑）
# ----------------------------------------------------------------------------

# 模型 Key：代码按顺序识别 Deepseek_API / DEEPSEEK_API / DEEPSEEK_API_KEY
# （Struct_of_Agent/common/config.py:23）。留空 → 无 Key，/health/live 的
# model_mode 显示 mock，属正常离线状态，不是故障。
Deepseek_API=
# 兼容别名（任选其一即可，与上一项等价；三个都空则视为未配置）：
#DEEPSEEK_API=
#DEEPSEEK_API_KEY=

# 说明：Deepseek_BASE_URL / Deepseek_MODEL 当前代码**不读取**（全仓库 grep 无命中）。
#   base_url / model 的实际来源是 config.py 的缺省值
#   （Struct_of_Agent/common/config.py:76 base_url=https://api.deepseek.com，
#   :78 model=deepseek-flash），运行时改法是在页面右上角「模型设置」里填
#   Base URL / Key / 模型名（存进程内存、不落盘），或直接改 config.py 缺省值。
#   下面两行仅作占位留档，取消注释不会生效：
#Deepseek_BASE_URL=https://api.deepseek.com
#Deepseek_MODEL=deepseek-flash

# 搜索 Key：代码按顺序识别 Tavily_API / TAVILY_API / TAVILY_API_KEY
# （Struct_of_Agent/common/config.py:120）。留空 → 不联网搜索，走离线回答。
Tavily_API=
#TAVILY_API_KEY=


# ----------------------------------------------------------------------------
# 3. 运行环境
# ----------------------------------------------------------------------------

# 运行环境名：local / test / demo（Struct_of_Agent/db/cli.py:57 读取，用于
#   scripts/db.py reset 的保护判断：BANK_AGENT_ENV 为 prod/production 时拒绝重置）。
BANK_AGENT_ENV=demo
# 演示租户覆盖（Struct_of_Agent/common/clock.py:76、common/hitl.py:75）。
#   演示数据只 seed 一个租户 demo-tenant（db/seed.py:31），一般无需改。
BANK_AGENT_DEMO_TENANT=demo-tenant
# Windows 下强制 UTF-8 输出，避免 GBK 乱码（由 Python 解释器读取）。
PYTHONIOENCODING=utf-8

# 历史别名说明（代码不读取，取消注释不生效，仅记录口径）：
#   BANK_AGENT_DEMO_MODE —— 早期文档写作「演示模式开关」；代码实际只认
#   BANK_AGENT_ENV=demo（见上），请勿依赖本别名。
#BANK_AGENT_DEMO_MODE=1
#   APP_ENV —— 通用别名，本仓库代码不读取；基座文档明确「不允许用单一 APP_ENV
#   选择不同真实端点」（见 docs/AI_Banking_Agent_项目基座文档.md:116）。
#APP_ENV=demo

# 可选进阶项（默认不配置，需要时再开）：
#BANK_AGENT_DATA_DIR=                      # 会话存储目录（web_test/session_store.py:36）
#BANK_AGENT_LEGACY_DATA_DIR=               # 旧 SQLite 导入目录（db/cli.py:185）
#BANK_AGENT_CLOCK_FAKE_AT=                 # 演示时钟冻结时间，ISO 8601（clock.py:73）


# ----------------------------------------------------------------------------
# 4. 写能力熔断（D01）
# ----------------------------------------------------------------------------
# 开关：0/false/no/off 关闭（circuit_breaker.py:337）；缺省开启（安全默认）。
BANK_AGENT_CIRCUIT_BREAKER_ENABLED=1
# 连续失败次数阈值，缺省 3（circuit_breaker.py:49,61）。
BANK_AGENT_CIRCUIT_FAILURE_THRESHOLD=3
# 首次冷却秒数，缺省 60；后续按 60→120→240→480→900 升级退避。
BANK_AGENT_CIRCUIT_COOLDOWN_SECONDS=60
# 失败计数窗口秒数，缺省 300。
BANK_AGENT_CIRCUIT_WINDOW_SECONDS=300
# 判定结果缓存 TTL 秒，缺省 5。
BANK_AGENT_CIRCUIT_CACHE_TTL_SECONDS=5
# 存储后端：memory（仅单测/离线演示）或库表存储（缺省，任何非 memory 值都走库）。
BANK_AGENT_CIRCUIT_BREAKER_STORE=sql


# ----------------------------------------------------------------------------
# 5. 人工介入 HITL（D03）
# ----------------------------------------------------------------------------
# 开关：0/false/no/off 关闭（hitl.py:533）；缺省开启。
BANK_AGENT_HITL_ENABLED=1
# 案件 SLA 秒数，缺省 900（15 分钟）；超时不自动批准，只转 expired。
BANK_AGENT_HITL_SLA_SECONDS=900
# 认领 TTL 秒数，缺省 300（5 分钟）；过期允许他人重新认领（ADR-004）。
BANK_AGENT_HITL_CLAIM_TTL_SECONDS=300


# ----------------------------------------------------------------------------
# 6. 高风险确认凭据（D04）
# ----------------------------------------------------------------------------
# 凭据有效期秒数，缺省 900（与 HITL SLA 对齐，confirm.py:60,66）。
BANK_AGENT_CONFIRM_GRANT_TTL=900
# 存储后端：memory（仅单测/离线演示）或库表存储（缺省，confirm.py:979）。
BANK_AGENT_CONFIRM_STORE=sql


# ----------------------------------------------------------------------------
# 7. 上下文记忆（D05）
# ----------------------------------------------------------------------------
# 开关：0/off/false/no/disable/disabled 关闭（memory.py:119）。
BANK_AGENT_MEMORY_ENABLED=1
# 保留的最近原文条数，缺省 8，最小 2。
BANK_AGENT_MEMORY_KEEP_MESSAGES=8
# 上下文预算（估算 token 数），缺省 3000，最小 32。
BANK_AGENT_MEMORY_MAX_TOKENS=3000
# 滚动摘要字数上限，缺省 800，最小 80。
BANK_AGENT_MEMORY_SUMMARY_CHARS=800


# ----------------------------------------------------------------------------
# 8. 受限代码沙箱（D02 / ADR-006）
# ----------------------------------------------------------------------------
# 能力模式：auto（默认，探测可用则用、不可用即降级）/ http（强制走沙箱）/
#   disabled（关闭，代码计算一律降级为标准统计）。非法值按 auto（code_compute.py:185）。
BANK_AGENT_CODE_COMPUTE_MODE=auto
# 沙箱基地址：**仅容器内可用**（http://code-sandbox:8022 是 compose 内网名）。
#   容器内 app 用这个值；宿主侧直跑服务时沙箱没有发布宿主端口，只能：
#     a) 临时 docker run -p 8022:8022 后设 http://127.0.0.1:8022（仅开发用），或
#     b) 设 BANK_AGENT_CODE_COMPUTE_MODE=disabled，代码计算降级（不建议演示用）。
BANK_AGENT_CODE_SANDBOX_URL=http://code-sandbox:8022


# ----------------------------------------------------------------------------
# 9. 变量清单速查表（变量：用途：默认/取值）
# ----------------------------------------------------------------------------
# BANK_AGENT_DB_URL                  ：数据库连接串（必填）        ：无，缺失即 fail-fast
# BANK_AGENT_TEST_DB_URL             ：集成测试维护库连接串        ：空（相关用例跳过）
# BANK_AGENT_PG_PORT                 ：compose PG 宿主端口映射      ：5432
# BANK_AGENT_API_PORT                ：compose API 宿主端口映射     ：8000
# BANK_AGENT_MODEL_MOCK_PORT         ：compose 模型 Mock 宿主端口   ：8010
# BANK_AGENT_DOCKER_DB_URL           ：容器内库连接串（compose 插值）：postgresql+psycopg://bank@db:5432/bank_agent_legacy
# Deepseek_API                       ：模型 Key（别名 DEEPSEEK_API）：空（离线 Mock）
# Tavily_API                         ：搜索 Key（别名 TAVILY_API）  ：空（不联网）
# BANK_AGENT_ENV                     ：运行环境名                  ：local（本文档建议 demo）
# BANK_AGENT_DEMO_TENANT             ：演示租户覆盖                ：demo-tenant
# PYTHONIOENCODING                   ：Python 输出编码              ：utf-8
# BANK_AGENT_CIRCUIT_BREAKER_ENABLED ：熔断开总开关                  ：开启（1）
# BANK_AGENT_CIRCUIT_FAILURE_THRESHOLD：连续失败阈值                ：3
# BANK_AGENT_CIRCUIT_COOLDOWN_SECONDS：首次冷却秒数                ：60
# BANK_AGENT_CIRCUIT_WINDOW_SECONDS  ：失败计数窗口秒数             ：300
# BANK_AGENT_CIRCUIT_CACHE_TTL_SECONDS：判定缓存 TTL 秒            ：5
# BANK_AGENT_CIRCUIT_BREAKER_STORE   ：熔断存储后端                  ：库表（memory=内存）
# BANK_AGENT_HITL_ENABLED            ：HITL 闸门开关                 ：开启（1）
# BANK_AGENT_HITL_SLA_SECONDS        ：案件 SLA 秒数                ：900
# BANK_AGENT_HITL_CLAIM_TTL_SECONDS  ：认领 TTL 秒数                ：300
# BANK_AGENT_CONFIRM_GRANT_TTL       ：确认凭据有效期秒数            ：900
# BANK_AGENT_CONFIRM_STORE           ：确认凭据存储后端              ：库表（memory=内存）
# BANK_AGENT_MEMORY_ENABLED          ：记忆开关                      ：开启（1）
# BANK_AGENT_MEMORY_KEEP_MESSAGES    ：压缩后保留原文条数            ：8
# BANK_AGENT_MEMORY_MAX_TOKENS       ：上下文预算（估算 token）      ：3000
# BANK_AGENT_MEMORY_SUMMARY_CHARS    ：摘要字数上限                  ：800
# BANK_AGENT_CODE_COMPUTE_MODE       ：沙箱能力模式                  ：auto
# BANK_AGENT_CODE_SANDBOX_URL        ：沙箱基地址（仅容器内）        ：http://code-sandbox:8022
# BANK_AGENT_DATA_DIR                ：会话数据目录                  ：空（按库/session_store 缺省）
# BANK_AGENT_LEGACY_DATA_DIR         ：旧 SQLite 导入目录            ：空（web_test/data）
# BANK_AGENT_CLOCK_FAKE_AT           ：演示时钟冻结时间              ：空（用真实时间）
# （不读取，仅留档：BANK_AGENT_DEMO_MODE、APP_ENV、Deepseek_BASE_URL、Deepseek_MODEL）
