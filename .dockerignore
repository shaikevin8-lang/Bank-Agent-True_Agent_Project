# 构建上下文裁剪：只把镜像真正需要的内容送给 docker build。
# 注意：这里刻意不写 docker/*/ 这类整目录通配排除 —— 否则 docker/code-sandbox
# 与 docker/model-mock 会被一起排除，它们的子构建上下文反而缺文件。

# ---- 版本库与本地虚拟环境 ----
.git
.venv
venv

# ---- Python 产物与测试缓存 ----
__pycache__
*.pyc
.pytest_cache
.pytest-tmp
.coverage*
htmlcov

# ---- 本地数据库与日志 ----
*.db
*.sqlite*
*.log

# ---- 临时目录 ----
tmp

# ---- 运行时数据（容器内自行创建，不必进上下文）----
Struct_of_Agent/web_test/data

# ---- 测试与文档（镜像运行不需要）----
tests
docs

# ---- 前端依赖 ----
node_modules

# ---- 环境变量（保留示例文件；真实密钥绝不进镜像）----
.env
.env.*
!.env.example

# ---- 编辑器 / IDE 配置 ----
.idea
.vscode
