# Python虚拟环境
.venv/
venv/
automotive-qa-venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# 日志、缓存
*.log
*.db
*.db-journal
*.sqlite
*.sqlite3
tmp/
# pytest 的 tmp_path 兜底目录（默认 %TEMP% 不可写时启用，见 tests/conftest.py）
.pytest-tmp/

# 覆盖率产物（pytest --cov 生成，仅本地看，绝不入库）
.coverage
.coverage.*
coverage.xml
htmlcov/

# 本地持久化数据库（R1 / R2 / 会话侧边栏；仅本机运行数据，绝不入库）
Struct_of_Agent/web_test/data/

# 前端测试依赖（仅 tests/frontend 使用 jsdom 做 DOM 测试，不属于产品运行时）
node_modules/
tests/frontend/package-lock.json

# 历史残迹目录（D14 防回归：曾出现过的 apps/、packages/ 脚手架残留，绝不再入库）
apps/
packages/

# IDE配置
.idea/
.vscode/

# 密钥与本地环境变量（绝不入库；API Key 只走环境变量/页面运行时填写）
.env
.env.*
# 例外：模板文件不含真实密钥，必须能入库（否则会被上面的 .env.* 规则误伤）
!.env.example
*.env
*.key
*.pem
secrets/
local_settings.*
# 阶段 9 提交打包产物（scripts/package_release.ps1 生成，zip 不入库）
dist/
