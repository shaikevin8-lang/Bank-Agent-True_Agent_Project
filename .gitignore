# Python虚拟环境
.venv/
venv/
automotive-qa-venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# 日志、缓存
*.log
tmp/
# pytest 的 tmp_path 兜底目录（默认 %TEMP% 不可写时启用，见 tests/conftest.py）
.pytest-tmp/

# 本地持久化数据库（R1 / R2 / 会话侧边栏；仅本机运行数据，绝不入库）
Struct_of_Agent/web_test/data/

# 前端测试依赖（仅 tests/frontend 使用 jsdom 做 DOM 测试，不属于产品运行时）
node_modules/
tests/frontend/package-lock.json

# IDE配置
.idea/
.vscode/

# 密钥与本地环境变量（绝不入库；API Key 只走环境变量/页面运行时填写）
.env
.env.*
*.env
*.key
*.pem
secrets/
local_settings.*

# 反编译/临时参考产物（重建测试源码用，不入库）
.decompiled/
.decompiled_security/
.pycdc_tool/
_probe_tmp.py
_verify_tmp.py
